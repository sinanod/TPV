DATABASE_URL="postgresql://tpv:tpv@localhost:5432/tpv_cloud?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
PORT=8080
# Orígenes extra permitidos por CORS/Socket.IO (separados por comas). En
# producción el portal se sirve desde el mismo dominio y no hace falta.
CORS_ORIGINS="http://localhost:5174"
# Base de datos que usan los tests (se borra en cada ejecución)
TEST_DATABASE_URL="postgresql://tpv:tpv@localhost:5432/tpv_cloud_test?schema=public"

# URL pública del portal: va en los QR de las mesas y en los emails
PUBLIC_BASE_URL="http://localhost:5174"

# Clave AES-256 (64 hex, openssl rand -hex 32) para cifrar los certificados de
# la AEAT. Obligatoria en producción; en desarrollo se usa una fija.
# CERT_ENCRYPTION_KEY=

# Productor del sistema de facturación (declaración responsable). Sin estos
# datos no se puede activar VERI*FACTU.
SIF_PRODUCER_NAME="Mi Empresa SL"
SIF_PRODUCER_NIF="B12345674"
# SIF_SYSTEM_NAME="TPV Restaurantes"
# SIF_SYSTEM_ID="TR"
# SIF_VERSION="1.0.0"

# SMTP para enviar los tickets por email (sin SMTP_HOST quedan en cola)
# SMTP_HOST=smtp.azurecomm.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Tickets <tickets@midominio.es>"

# Pasarela del pago desde el móvil: "demo" (simula, no cobra) o vacío (desactivado)
PAYMENT_PROVIDER=demo
