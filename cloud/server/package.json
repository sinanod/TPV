{
  "name": "tpv-cloud-server",
  "version": "1.0.0",
  "description": "Backend del portal de administración multi-restaurante (Azure)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "tenant": "tsx src/cli/tenant.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^4.5.7",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^6.10.1",
    "pngjs": "^7.0.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.24",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "smtp-server": "^3.20.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
